<Window x:Class="Object1688.ConfigUI.NewRuleWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建规则向导"
        Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StepHeader" Grid.Row="0" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Text="第 1/3 步：匹配"/>

        <Grid Grid.Row="1">
            <StackPanel x:Name="Step1Panel">
                <TextBlock Text="匹配类型" Margin="0,4,0,2"/>
                <ComboBox x:Name="WizMatchTypeCombo">
                    <ComboBoxItem Content="进程名"/>
                    <ComboBoxItem Content="窗口标题"/>
                </ComboBox>
                <TextBlock Text="匹配模式" Margin="0,8,0,2"/>
                <ComboBox x:Name="WizMatchModeCombo">
                    <ComboBoxItem Content="完全"/>
                    <ComboBoxItem Content="包含"/>
                    <ComboBoxItem Content="通配"/>
                </ComboBox>
                <TextBlock Text="匹配值（如 chrome.exe 或 *游戏*）" Margin="0,8,0,2"/>
                <TextBox x:Name="WizMatchValueBox"/>
            </StackPanel>

            <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                <TextBlock Text="显示文字（每行一条，支持 {appName}/{time}）" Margin="0,4,0,2"/>
                <TextBox x:Name="WizTextLinesBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="字号" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="WizFontSizeBox" Width="64" TextAlignment="Right" Text="96"/>
                    <TextBlock Text="延时(s)" VerticalAlignment="Center" Margin="16,0,4,0"/>
                    <TextBox x:Name="WizDelayBox" Width="52" TextAlignment="Right" Text="2"/>
                    <TextBlock Text="保持(s)" VerticalAlignment="Center" Margin="16,0,4,0"/>
                    <TextBox x:Name="WizHoldBox" Width="52" TextAlignment="Right" Text="4"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                <TextBlock Text="确认新建规则：" FontWeight="Bold" Margin="0,4,0,6"/>
                <TextBlock x:Name="WizSummaryText" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="WizBackButton" Content="上一步" Width="80" Click="OnBackClicked" IsEnabled="False"/>
            <Button x:Name="WizNextButton" Content="下一步" Width="80" Margin="8,0,0,0" Click="OnNextClicked"/>
            <Button x:Name="WizFinishButton" Content="完成" Width="80" Margin="8,0,0,0" Click="OnFinishClicked" Visibility="Collapsed"/>
            <Button x:Name="WizCancelButton" Content="取消" Width="80" Margin="8,0,0,0" Click="OnCancelClicked"/>
        </StackPanel>
    </Grid>
</Window>
