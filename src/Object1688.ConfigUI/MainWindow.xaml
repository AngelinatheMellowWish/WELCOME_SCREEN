<Window x:Class="Object1688.ConfigUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ConfigWindowTitle}"
        Width="960" Height="620"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏（架构 §5.8） -->
        <ToolBarTray Grid.Row="0" IsLocked="True">
            <ToolBar>
                <Button x:Name="NewRuleButton" Content="{DynamicResource CfgNewRule}" Click="OnNewRuleClicked" ToolTip="新建一条触发规则（F-28 空状态引导入口）"/>
                <Button x:Name="NewRuleWizardButton" Content="{DynamicResource CfgNewWizard}" Click="OnNewRuleWizardClicked" ToolTip="分步向导新建规则（F-28/AC-57）"/>
                <Button x:Name="DeleteRuleButton" Content="{DynamicResource CfgDeleteRule}" Click="OnDeleteRuleClicked" ToolTip="删除当前选中的规则"/>
                <Separator/>
                <Button x:Name="RestoreDefaultsButton" Content="{DynamicResource CfgRestoreDefaults}" Click="OnRestoreDefaultsClicked" ToolTip="将当前配置重置为内置默认（未保存不落盘）"/>
                <Separator/>
                <Button x:Name="ImportButton" Content="{DynamicResource CfgImport}" Click="OnImportClicked" ToolTip="从 JSON 文件导入配置（导入前自动备份当前配置，F-22/AC-21）"/>
                <Button x:Name="ExportButton" Content="{DynamicResource CfgExport}" Click="OnExportClicked" ToolTip="将当前配置导出为 JSON 文件（F-22/AC-21）"/>
                <Button x:Name="ConflictCheckButton" Content="{DynamicResource CfgConflictCheck}" Click="OnConflictCheckClicked" ToolTip="检测规则完全重复/匹配重叠并列出（F-29/AC-58）"/>
                <Separator/>
                <Button x:Name="TestPlayButton" Content="{DynamicResource CfgTestPlay}" Click="OnTestPlayClicked" ToolTip="组装当前规则为 BannerRequest 并经 Main 下发 Overlay 真实播放（F-23）"/>
                <Button x:Name="SaveButton" Content="{DynamicResource CfgSave}" Click="OnSaveClicked" ToolTip="校验 → 原子写盘 → 广播 ConfigChanged 热生效（CFG-I-1004）"/>
            </ToolBar>
        </ToolBarTray>

        <!-- 主体：左规则列表 + 右页签编辑区（架构 §5.8） -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：规则列表 -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="2,0,0,4">
                    <TextBlock Text="{DynamicResource CfgRulesHeader}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="AddRuleButton" Content="＋" Width="24" Padding="0" Margin="6,0,0,0"
                            Click="OnNewRuleClicked" ToolTip="新建规则"
                            AutomationProperties.Name="新建规则"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBox x:Name="SearchBox" Width="120" ToolTip="{DynamicResource CfgSearchTip}"
                             AutomationProperties.Name="搜索规则"
                             TextChanged="OnSearchTextChanged"/>
                    <Button x:Name="CopyRuleButton" Content="{DynamicResource CfgCopy}" Margin="4,0,0,0" Click="OnCopyRuleClicked"
                            ToolTip="复制选中规则为深拷贝新 ruleId（F-27）"/>
                    <Button x:Name="MoveUpButton" Content="↑" Width="24" Padding="0" Margin="4,0,0,0"
                            Click="OnMoveUpClicked" ToolTip="{DynamicResource CfgMoveUpTip}"
                            AutomationProperties.Name="上移规则"/>
                    <Button x:Name="MoveDownButton" Content="↓" Width="24" Padding="0" Margin="2,0,0,0"
                            Click="OnMoveDownClicked" ToolTip="{DynamicResource CfgMoveDownTip}"
                            AutomationProperties.Name="下移规则"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="EnableAllButton" Content="{DynamicResource CfgEnableAll}" Padding="8,2" Click="OnEnableAllClicked"/>
                    <Button x:Name="DisableAllButton" Content="{DynamicResource CfgDisableAll}" Padding="8,2" Margin="4,0,0,0" Click="OnDisableAllClicked"/>
                </StackPanel>
                <ListBox x:Name="RulesListBox"
                         Grid.Row="3"
                         BorderBrush="#CCCCCC" BorderThickness="1"
                         SelectionChanged="OnRuleSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" Margin="2,0,6,0"
                                          ToolTip="启用/禁用（F-20）"/>
                                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 右：页签编辑区 -->
            <TabControl Grid.Column="1" x:Name="MainTabControl" SelectionChanged="OnMainTabChanged">

                <!-- ===== 页签 1：触发规则 ===== -->
                <TabItem Header="{DynamicResource CfgTabRules}">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 匹配配置 -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource CfgMatchType}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="MatchTypeCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,12,4"
                                      SelectionChanged="OnRuleComboSelChanged"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource CfgMatchMode}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="MatchModeCombo" Grid.Row="0" Grid.Column="3" Margin="0,0,0,4"
                                      SelectionChanged="OnRuleComboSelChanged"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource CfgMatchValue}" VerticalAlignment="Center" Margin="0,0,4,4"/>
                            <TextBox x:Name="MatchValueBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4"
                                     TextChanged="OnRuleTextChanged" ToolTip="{DynamicResource CfgMatchValueTip}"/>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox x:Name="EnableRuleCheck" Content="{DynamicResource CfgEnable}" Margin="0,0,16,0"
                                          Checked="OnRuleCheckedChanged" Unchecked="OnRuleCheckedChanged"/>
                                <CheckBox x:Name="CaseSensitiveCheck" Content="{DynamicResource CfgCaseSensitive}" Margin="0,0,16,0"
                                          Checked="OnRuleCheckedChanged" Unchecked="OnRuleCheckedChanged"/>
                                <CheckBox x:Name="IncludeFullscreenCheck" Content="{DynamicResource CfgFullscreen}" Margin="0,0,16,0"
                                          Checked="OnRuleCheckedChanged" Unchecked="OnRuleCheckedChanged"/>
                                <TextBlock Text="{DynamicResource CfgTargetScreen}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="TargetScreenBox" Width="90"
                                         TextChanged="OnRuleTextChanged" ToolTip="primary 或显示器索引号"/>
                            </StackPanel>
                        </Grid>

                        <!-- 文字行编辑（F-06） -->
                        <GroupBox Grid.Row="1" Header="{DynamicResource CfgLinesHeader}" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="LinesBox" Grid.Row="0" Height="72" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         TextChanged="OnRuleTextChanged"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{DynamicResource CfgFontSize}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="FontSizeBox" Width="64" TextAlignment="Right"
                                             TextChanged="OnRuleTextChanged" ToolTip="块级默认字号（DIP），0 = 全局默认 96"/>
                                    <TextBlock Text="{DynamicResource CfgDelay}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                    <TextBox x:Name="DelaySecondsBox" Width="52" TextAlignment="Right"
                                             TextChanged="OnRuleTextChanged"/>
                                    <TextBlock Text="{DynamicResource CfgHold}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                    <TextBox x:Name="HoldSecondsBox" Width="52" TextAlignment="Right"
                                             TextChanged="OnRuleTextChanged"/>
                                    <TextBlock Text="{DynamicResource CfgPosition}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                    <ComboBox x:Name="PositionCombo" Width="110" SelectionChanged="OnRuleComboSelChanged"/>
                                    <TextBlock Text="{DynamicResource CfgOutlineColor}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                    <TextBox x:Name="OutlineColorBox" Width="80"
                                             TextChanged="OnRuleTextChanged" ToolTip="#RRGGBB，空 = 全局默认"/>
                                    <TextBlock Text="{DynamicResource CfgOutlineWidth}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                    <TextBox x:Name="OutlineWidthBox" Width="52" TextAlignment="Right"
                                             TextChanged="OnRuleTextChanged" ToolTip="DIP，0 = 无描边"/>
                                    <TextBlock Text="{DynamicResource CfgOutlineMode}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                    <ComboBox x:Name="OutlineModeCombo" Width="120" SelectionChanged="OnRuleComboSelChanged"
                                              ToolTip="柔光=方案A（边缘柔光，开销低）；精确=方案B（实心描边，清晰）；跟随全局默认">
                                        <ComboBoxItem Content="跟随全局" Tag=""/>
                                        <ComboBoxItem Content="柔光（方案A）" Tag="shadow"/>
                                        <ComboBoxItem Content="精确（方案B）" Tag="stroke"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{DynamicResource CfgPreset}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <ComboBox x:Name="PresetCombo" Width="200"
                                              ToolTip="内置样式预设（Control 经典/高对比/字幕风/影院深底）"/>
                                    <Button x:Name="ApplyPresetButton" Content="{DynamicResource CfgApply}" Margin="6,0,0,0" Padding="10,2"
                                            Click="OnApplyPresetClicked"
                                            ToolTip="将预设参数（字号/描边/位置）套用到当前规则，套用后仍可微调（F-23/AC-60）"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- 预览区（F-23；AC-66 拖拽定位） -->
                        <GroupBox Grid.Row="2" Header="{DynamicResource CfgPreviewHeader}" Margin="0,0,0,0">
                            <Border x:Name="PreviewBorder" Background="#1E1E1E" CornerRadius="4">
                                <Canvas x:Name="PreviewCanvas" Background="Transparent" ClipToBounds="True"
                                        AutomationProperties.Name="大字预览（可拖拽定位）"
                                        MouseLeftButtonDown="OnPreviewMouseDown"
                                        MouseMove="OnPreviewMouseMove"
                                        MouseLeftButtonUp="OnPreviewMouseUp"
                                        SizeChanged="OnPreviewSizeChanged">
                                    <TextBlock x:Name="PreviewTextBlock"
                                               Foreground="White"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               FontWeight="Bold"
                                               Text="（从左侧选择规则或新建后显示预览）"/>
                                </Canvas>
                            </Border>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- ===== 页签 2：欢迎大字（F-11） ===== -->
                <TabItem Header="{DynamicResource CfgTabWelcome}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,8,4,4">
                            <CheckBox x:Name="WelcomeEnabledCheck" Content="{DynamicResource CfgWelcomeEnabled}" Margin="0,0,0,8"
                                      Checked="OnWelcomeCheckedChanged" Unchecked="OnWelcomeCheckedChanged"/>
                            <TextBlock Text="{DynamicResource CfgWelcomeLines}" Margin="0,0,0,4"/>
                            <TextBox x:Name="WelcomeLinesBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" TextChanged="OnWelcomeTextChanged"
                                     ToolTip="多行段落；{appName}/{time} 占位符按实际替换"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource CfgFontSize}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="WelcomeFontSizeBox" Width="64" TextAlignment="Right" TextChanged="OnWelcomeTextChanged"/>
                                <TextBlock Text="{DynamicResource CfgDelay}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                <TextBox x:Name="WelcomeDelaySecondsBox" Width="52" TextAlignment="Right" TextChanged="OnWelcomeTextChanged"/>
                                <TextBlock Text="{DynamicResource CfgHold}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                <TextBox x:Name="WelcomeHoldSecondsBox" Width="52" TextAlignment="Right" TextChanged="OnWelcomeTextChanged"/>
                            </StackPanel>
                            <TextBlock x:Name="WelcomeHint" Foreground="#888" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="欢迎大字在程序每次启动（自启或手动双击）时自动显示一次（AC-06），可独立开关。"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 页签 3：手动大字（F-12） ===== -->
                <TabItem Header="{DynamicResource CfgTabManual}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,8,4,4">
                            <CheckBox x:Name="ManualEnabledCheck" Content="{DynamicResource CfgManualEnabled}" Margin="0,0,0,8"
                                      Checked="OnManualCheckedChanged" Unchecked="OnManualCheckedChanged"/>
                            <TextBlock Text="{DynamicResource CfgManualLines}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ManualLinesBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" TextChanged="OnManualTextChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource CfgFontSize}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="ManualFontSizeBox" Width="64" TextAlignment="Right" TextChanged="OnManualTextChanged"/>
                                <TextBlock Text="{DynamicResource CfgHold}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                <TextBox x:Name="ManualHoldSecondsBox" Width="52" TextAlignment="Right" TextChanged="OnManualTextChanged"/>
                                <TextBlock Text="{DynamicResource CfgShortcut}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                <TextBox x:Name="ManualShortcutBox" Width="120" TextChanged="OnManualTextChanged"
                                         ToolTip="如 Alt+F；清空 = 禁用快捷键（F-12/AC-71）"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource CfgOutlineMode}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox x:Name="ManualOutlineModeCombo" Width="140" SelectionChanged="OnManualSelChanged"
                                          ToolTip="手动大字独立描边方式；跟随全局=用全局默认">
                                    <ComboBoxItem Content="跟随全局" Tag=""/>
                                    <ComboBoxItem Content="柔光（方案A）" Tag="shadow"/>
                                    <ComboBoxItem Content="精确（方案B）" Tag="stroke"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock x:Name="ManualHint" Foreground="#888" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="手动大字独立配置（区别于规则/欢迎大字，AC-29）；托盘或快捷键触发，Esc/再按快捷键提前结束（AC-30）。"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 页签 4：勿扰/提示音/自启 ===== -->
                <TabItem Header="{DynamicResource CfgTabDnd}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,8,4,4">
                            <GroupBox Header="{DynamicResource CfgDndHeader}">
                                <StackPanel Margin="4">
                                    <CheckBox x:Name="DndPausedCheck" Content="{DynamicResource CfgDndPaused}" Margin="0,2,0,6"
                                              Checked="OnDndCheckedChanged" Unchecked="OnDndCheckedChanged"/>
                                    <CheckBox x:Name="DndScheduleEnabledCheck" Content="{DynamicResource CfgDndSchedule}" Margin="0,2,0,6"
                                              Checked="OnDndCheckedChanged" Unchecked="OnDndCheckedChanged"/>
                                    <CheckBox x:Name="DndPresentationSilenceCheck" Content="{DynamicResource CfgDndPresentation}" Margin="0,2,0,6"
                                              Checked="OnDndCheckedChanged" Unchecked="OnDndCheckedChanged"/>
                                    <TextBlock x:Name="DndScheduleHint" Text="定时时段编辑请在 config.default.json / 手动编辑配置（UI 完整时段编辑器待 M4-E）" Foreground="#888" TextWrapping="Wrap"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="大字描边（全局默认）" Margin="0,8,0,0">
                                <StackPanel Margin="4">
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{DynamicResource CfgOutlineMode}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="GlobalOutlineModeCombo" Width="140" SelectionChanged="OnGlobalSelChanged"
                                                  ToolTip="规则/手动大字未单独指定描边方式时沿用此全局默认（架构 §3.3）">
                                            <ComboBoxItem Content="柔光（方案A）" Tag="shadow"/>
                                            <ComboBoxItem Content="精确（方案B）" Tag="stroke"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Text="柔光=方案A（DropShadow 边缘柔光，开销低）；精确=方案B（多向实心描边，清晰醒目）。" Foreground="#888" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="{DynamicResource CfgSoundHeader}" Margin="0,8,0,0">
                                <StackPanel Margin="4">
                                    <CheckBox x:Name="SoundEnabledCheck" Content="{DynamicResource CfgSoundEnabled}" Margin="0,2,0,6"
                                              Checked="OnSoundCheckedChanged" Unchecked="OnSoundCheckedChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                        <TextBlock Text="{DynamicResource CfgSoundSource}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="SoundSourceCombo" Width="110" SelectionChanged="OnSoundSelChanged">
                                            <ComboBoxItem Content="system" Tag="system"/>
                                            <ComboBoxItem Content="custom" Tag="custom"/>
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource CfgSoundVolume}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                                        <TextBox x:Name="SoundVolumeBox" Width="52" TextAlignment="Right" TextChanged="OnSoundTextChanged"/>
                                    </StackPanel>
                                    <TextBlock Text="自定义音频路径（Source=custom 时，wav/mp3，≤10MB，相对路径限资源目录）" Foreground="#888"/>
                                    <TextBox x:Name="SoundCustomPathBox" TextChanged="OnSoundTextChanged" Margin="0,2,0,0"
                                             ToolTip="格式/大小/路径安全校验（CFG-V-1007）；可点右侧按钮浏览选择"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="{DynamicResource CfgAutostartHeader}" Margin="0,8,0,0">
                                <StackPanel Margin="4">
                                    <CheckBox x:Name="AutostartCheck" Content="{DynamicResource CfgAutostart}" Margin="0,2,0,0"
                                              Checked="OnAutostartCheckedChanged" Unchecked="OnAutostartCheckedChanged"/>
                                    <TextBlock x:Name="AutostartHint" Text="自启路径失效检测提示见 M4-E（AC-53）" Foreground="#888" Margin="0,6,0,0"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 页签 5：使用说明（AC-55 内置帮助） ===== -->
                <TabItem Header="{DynamicResource CfgTabHelp}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8,10,8,8" MaxWidth="860">
                            <TextBlock FontWeight="Bold" FontSize="15" Text="Object1688 配置说明" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#333">
                                本窗口分五个页签：触发规则、欢迎大字、手动大字、勿扰/提示音/自启、使用说明。修改后点击上方"保存"校验并原子写盘，经主进程广播热生效。
                            </TextBlock>
                            <GroupBox Header="触发规则">
                                <StackPanel Margin="4">
                                    <TextBlock TextWrapping="Wrap">· 匹配类型：进程名（如 chrome.exe）或窗口标题文本；匹配模式：完全 / 包含 / 通配（支持 * 与 ?）。</TextBlock>
                                    <TextBlock TextWrapping="Wrap">· 匹配值 = 命中目标时显示对应大字；每条规则可用启用开关独立启停。</TextBlock>
                                    <TextBlock TextWrapping="Wrap">· 列表工具：搜索过滤、复制（深拷贝新 ruleId）、↑/↓ 调整优先级（同命中按序播放）、全部启用/停用。</TextBlock>
                                    <TextBlock TextWrapping="Wrap">· Ctrl+Z / Ctrl+Y 可撤销/重做新建、删除、复制、移动、批量启停等结构操作（AC-64）。</TextBlock>
                                    <TextBlock TextWrapping="Wrap">· 文字行支持 {appName}（命中进程名）与 {time}（当前时间，格式见全局配置）占位符。</TextBlock>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="欢迎大字 / 手动大字" Margin="0,8,0,0">
                                <StackPanel Margin="4">
                                    <TextBlock TextWrapping="Wrap">· 欢迎大字：程序每次启动自动显示一次（可独立开关，AC-06）。</TextBlock>
                                    <TextBlock TextWrapping="Wrap">· 手动大字：通过托盘菜单"手动大字"或全局快捷键触发（默认 Alt+F，可改/清空禁用），独立于规则配置（AC-29）。</TextBlock>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="勿扰 / 提示音 / 自启" Margin="0,8,0,0">
                                <StackPanel Margin="4">
                                    <TextBlock TextWrapping="Wrap">· 全局暂停：暂停期间自动触发不弹大字，但事件照常记录（手动/测试为强制路径，AC-31）。</TextBlock>
                                    <TextBlock TextWrapping="Wrap">· 定时勿扰：按配置时段自动静默；提示音可切换自定义音频（wav/mp3，≤10MB）。</TextBlock>
                                    <TextBlock TextWrapping="Wrap">· 开机自启：默认开启；注册表项失效时启动会提示并引导（AC-23/AC-53）。</TextBlock>
                                </StackPanel>
                            </GroupBox>
                            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#666">
                                数据仅存本机，绝不上传（NFR-04）。日志与事件流含窗口标题仅用于排障，可在性能窗口一键清除历史。
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 底部状态栏 -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="{DynamicResource CfgReady}" TextTrimming="CharacterEllipsis"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
