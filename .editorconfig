# ===== .editorconfig：C#/分析器规则唯一源（开发规范 §3.1）=====
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{xaml,json,yml,yaml,ps1,md,txt}]
indent_size = 2

# ---- C# 命名规范（开发规范 §2.2）----
[*.cs]
dotnet_naming_rule.private_fields_should_begin_with_underscore.severity = suggestion
dotnet_naming_rule.private_fields_should_begin_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_should_begin_with_underscore.style = underscore_style
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.required_modifiers = private
dotnet_naming_style.underscore_style.required_prefix = _
dotnet_naming_style.underscore_style.capitalization = camel_case

dotnet_naming_rule.public_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.public_members_should_be_pascal_case.symbols = public_symbols
dotnet_naming_rule.public_members_should_be_pascal_case.style = pascal_case_style
dotnet_naming_symbols.public_symbols.applicable_kinds = property,method,event,class,struct,interface,enum,delegate
dotnet_naming_symbols.public_symbols.required_modifiers = public
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.interfaces_should_begin_with_i.severity = suggestion
dotnet_naming_rule.interfaces_should_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_begin_with_i.style = i_style
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.i_style.required_prefix = I
dotnet_naming_style.i_style.capitalization = pascal_case

# ---- 代码风格（suggestion 级别，不阻断构建）----
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_sort_system_directives_first = true:suggestion

# ---- 分析器规则（Error 级仅启用明确要求的门禁；其余维持 SDK 默认）----
# 文档注释门禁：公开成员缺失 XML 注释 → 警告（由 TreatWarningsAsErrors 升为错误）
dotnet_diagnostic.CS1591.severity = warning
# 异步方法需 Async 后缀（开发规范 §2.3）
dotnet_diagnostic.VSTHRD200.severity = none

# ---- 豁免登记（开发规范 §3.1：按文件/目录收窄，注释理由）----
# obj/ 生成代码不参与分析
[**/obj/**]
dotnet_analyzer_diagnostic.severity = none