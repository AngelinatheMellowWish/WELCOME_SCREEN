# 统一换行符：Git 检出时使用 CRLF（Windows），仓库内存储 LF
* text=auto
# 文本文件强制 LF 存储
*.cs text eol=crlf
*.xaml text eol=crlf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=crlf
*.ps1 text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
# 二进制标记
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.dmp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip filter=lfs diff=lfs merge=lfs -text
